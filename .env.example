# Environment variables template for DuoVerse
# Copy this to server/.env and fill in real values

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/two_friends_studio
# Online MongoDB Atlas (Free M0 Cluster):
# Replace <username>, <password>, and <cluster-url> with your Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/two_friends_studio?retryWrites=true&w=majority&appName=Cluster0

# ─── Frontend API URL (Leave blank or '/api' when deploying to Vercel) ─────────
# On Vercel, requests use relative '/api' automatically.
# For local dev with separate ports: http://localhost:5000/api
VITE_API_BASE_URL=/api

# ─── Email / SMTP Credentials ────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
RECEIVER_EMAIL=your_receiving_email@gmail.com

# Optional second founder receiver
CONTACT_RECEIVER_EMAIL_2=second_founder@gmail.com
