# Environment variables template for DuoVerse
# Copy this to server/.env and fill in real values

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/duoverse_studio

# ─── Frontend API URL ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api

# ─── Email / SMTP Credentials ────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
RECEIVER_EMAIL=your_receiving_email@gmail.com

# Optional second founder receiver
CONTACT_RECEIVER_EMAIL_2=second_founder@gmail.com
